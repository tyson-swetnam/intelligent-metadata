{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRIDE Proteomics Project Metadata Template",
  "description": "Template for metadata from the PRIDE (Proteomics Identifications Database) Archive",
  "type": "object",
  "properties": {
    "accession": {
      "type": "string",
      "description": "PRIDE project accession number (e.g., PXD000001)",
      "pattern": "^PXD\\d+$",
      "example": "PXD000001"
    },
    "title": {
      "type": "string",
      "description": "Project title",
      "example": "Proteome analysis of cancer cell lines"
    },
    "projectDescription": {
      "type": "string",
      "description": "Detailed description of the project",
      "example": "This study investigates the proteome of various cancer cell lines..."
    },
    "sampleProcessingProtocol": {
      "type": "string",
      "description": "Protocol used for sample processing",
      "example": "Cells were lysed in RIPA buffer..."
    },
    "dataProcessingProtocol": {
      "type": "string",
      "description": "Protocol used for data processing (may contain HTML)",
      "example": "Raw data were processed using MaxQuant..."
    },
    "projectTags": {
      "type": "array",
      "description": "Project classification tags",
      "items": {
        "type": "string"
      },
      "example": ["Biological", "Biomedical"]
    },
    "keywords": {
      "type": "array",
      "description": "Keywords describing the project",
      "items": {
        "type": "string"
      },
      "example": ["cancer", "proteomics", "cell lines"]
    },
    "doi": {
      "type": "string",
      "description": "Digital Object Identifier",
      "pattern": "^10\\.\\d+/.+$",
      "example": "10.6019/PXD000001"
    },
    "submissionType": {
      "type": "string",
      "description": "Type of data submission",
      "enum": ["COMPLETE", "PARTIAL", "PRIDE"],
      "example": "COMPLETE"
    },
    "license": {
      "type": "string",
      "description": "Data license",
      "example": "CC BY 4.0"
    },
    "submissionDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date of project submission",
      "example": "2012-06-01T00:00:00Z"
    },
    "publicationDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date of project publication",
      "example": "2012-07-15T00:00:00Z"
    },
    "totalFileDownloads": {
      "type": "integer",
      "description": "Total number of file downloads",
      "minimum": 0,
      "example": 1523
    },
    "submitters": {
      "type": "array",
      "description": "List of project submitters",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Dr."
          },
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Smith"
          },
          "name": {
            "type": "string",
            "description": "Full name",
            "example": "John Smith"
          },
          "identifier": {
            "type": "string",
            "description": "Unique identifier"
          },
          "id": {
            "type": "string",
            "description": "Internal ID"
          },
          "affiliation": {
            "type": "string",
            "description": "Institutional affiliation",
            "example": "University of Example"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.smith@example.edu"
          },
          "country": {
            "type": "string",
            "description": "Country",
            "example": "United States"
          },
          "orcid": {
            "type": "string",
            "description": "ORCID identifier",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$",
            "example": "0000-0001-2345-6789"
          }
        },
        "required": ["firstName", "lastName"]
      }
    },
    "labPIs": {
      "type": "array",
      "description": "Principal Investigators",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Prof."
          },
          "firstName": {
            "type": "string",
            "example": "Jane"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "affiliation": {
            "type": "string",
            "example": "Institute of Proteomics"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "country": {
            "type": "string"
          },
          "orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$"
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "description": "Mass spectrometry instruments used",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "description": "Controlled vocabulary label",
            "example": "MS"
          },
          "accession": {
            "type": "string",
            "description": "Ontology accession number",
            "example": "MS:1000449"
          },
          "name": {
            "type": "string",
            "description": "Instrument name",
            "example": "LTQ Orbitrap"
          }
        },
        "required": ["@type", "cvLabel", "accession", "name"]
      }
    },
    "experimentTypes": {
      "type": "array",
      "description": "Types of experiments performed",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "MS"
          },
          "accession": {
            "type": "string",
            "example": "MS:1001926"
          },
          "name": {
            "type": "string",
            "example": "DDA"
          }
        }
      }
    },
    "organisms": {
      "type": "array",
      "description": "Organisms studied",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "NEWT"
          },
          "accession": {
            "type": "string",
            "example": "9606"
          },
          "name": {
            "type": "string",
            "description": "Organism name",
            "example": "Homo sapiens (Human)"
          }
        }
      }
    },
    "organismParts": {
      "type": "array",
      "description": "Organism parts or tissues studied",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "BTO"
          },
          "accession": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "liver"
          }
        }
      }
    },
    "diseases": {
      "type": "array",
      "description": "Diseases studied",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "DOID"
          },
          "accession": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "cancer"
          }
        }
      }
    },
    "identifiedPTMStrings": {
      "type": "array",
      "description": "Post-translational modifications identified",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "MOD"
          },
          "accession": {
            "type": "string",
            "example": "MOD:00696"
          },
          "name": {
            "type": "string",
            "example": "phosphorylated residue"
          }
        }
      }
    },
    "sampleAttributes": {
      "type": "array",
      "description": "Sample characteristics and attributes",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "object",
            "description": "Attribute key as CvParam",
            "properties": {
              "@type": {
                "type": "string",
                "const": "CvParam"
              },
              "cvLabel": {
                "type": "string"
              },
              "accession": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "example": "cell line"
              }
            }
          },
          "value": {
            "type": "array",
            "description": "Attribute values",
            "items": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string",
                  "const": "CvParam"
                },
                "cvLabel": {
                  "type": "string"
                },
                "accession": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "example": "HeLa"
                }
              }
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Associated publications",
      "items": {
        "type": "object",
        "properties": {
          "referenceLine": {
            "type": "string",
            "description": "Full citation",
            "example": "Smith J et al. (2012) Nature, 123:456-789"
          },
          "pubmedID": {
            "type": "integer",
            "description": "PubMed identifier",
            "example": 22345678
          },
          "doi": {
            "type": "string",
            "description": "Publication DOI",
            "example": "10.1038/nature12345"
          }
        }
      }
    },
    "countries": {
      "type": "array",
      "description": "Countries associated with the project",
      "items": {
        "type": "string"
      },
      "example": ["United States", "United Kingdom"]
    },
    "softwares": {
      "type": "array",
      "description": "Software tools used for analysis",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "MS"
          },
          "accession": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "MaxQuant"
          }
        }
      }
    },
    "quantificationMethods": {
      "type": "array",
      "description": "Quantification methods used",
      "items": {
        "type": "object",
        "properties": {
          "@type": {
            "type": "string",
            "const": "CvParam"
          },
          "cvLabel": {
            "type": "string",
            "example": "MS"
          },
          "accession": {
            "type": "string",
            "example": "MS:1001834"
          },
          "name": {
            "type": "string",
            "example": "LC-MS label-free quantitation analysis"
          }
        }
      }
    },
    "additionalAttributes": {
      "type": "array",
      "description": "Additional custom attributes",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "accession",
    "title",
    "submissionType",
    "submissionDate"
  ],
  "additionalProperties": false
}
